# ═══════════════════════════════════════════════════════════════
#  Atlas — exemplo de variáveis de ambiente
#
#  COPIE este arquivo para .env e preencha com os valores reais:
#
#      cp .env.example .env          # Linux / macOS
#      copy .env.example .env        # Windows
#
#  ⚠️ O arquivo .env está no .gitignore e NUNCA deve ser commitado.
#     Este .env.example (sem valores reais) É versionado, e serve
#     como documentação de quais variáveis o projeto precisa.
#
#  Esse par .env / .env.example é o padrão da indústria. Ele resolve
#  a pergunta "quais variáveis eu preciso configurar?" sem expor
#  nenhum segredo.
# ═══════════════════════════════════════════════════════════════

# ── Módulo 01–02: ainda não usamos variáveis de ambiente ─────
# O Atlas atual lê tudo de src/atlas/config.py.
# Este arquivo já existe para você pegar o hábito.

# ── Módulo 05: PostgreSQL ────────────────────────────────────
# Usadas pelo docker-compose.yml E pela aplicação.
ATLAS_DB_USER=atlas
ATLAS_DB_PASSWORD=troque-esta-senha
ATLAS_DB_NAME=atlas
ATLAS_DB_HOST=localhost
ATLAS_DB_PORT=5432

# Alternativa: URL completa (tem precedência sobre as partes acima).
# Útil em CI e em plataformas PaaS, que costumam fornecer uma DATABASE_URL.
# ⚠️ Senha com caractere especial (@ / : #) precisa ser codificada.
# ATLAS_DB_URL=postgresql+psycopg://atlas:senha@localhost:5432/atlas

# ── Módulo 05: MongoDB ───────────────────────────────────────
ATLAS_MONGO_USER=atlas
ATLAS_MONGO_PASSWORD=troque-esta-senha-tambem
ATLAS_MONGO_DB=atlas_catalogo
ATLAS_MONGO_URI=mongodb://localhost:27017

# ── Módulo 06: API ───────────────────────────────────────────
# 🔴 GERE A SUA. Não use este valor, não copie de tutorial nenhum:
#
#       python -c "import secrets; print(secrets.token_urlsafe(48))"
#
#    A aplicação se RECUSA a subir com menos de 32 caracteres ou com
#    um valor de exemplo conhecido. Isso é proposital.
#
#    💭 Já houve incidente real por causa disso: alguém copia a chave
#       do README, publica o projeto, e todo mundo que leu o README
#       consegue forjar tokens de admin.
ATLAS_SECRET_KEY=gere-uma-chave-aleatoria-longa

# Validade do token de acesso, em minutos (5 a 1440).
# 💡 Curto limita o estrago de um vazamento. O padrão da indústria é
#    15–30 min de acesso + um refresh token de dias.
ATLAS_TOKEN_EXPIRA_MINUTOS=60

# desenvolvimento | homologacao | producao
ATLAS_AMBIENTE=desenvolvimento

# Origens do front-end, em JSON.
# 🔴 Em produção, NUNCA ["*"] — e jamais ["*"] junto com credenciais,
#    combinação que os próprios navegadores recusam.
ATLAS_ORIGENS_PERMITIDAS=["http://localhost:3000","http://127.0.0.1:5173"]

# Paginação
ATLAS_PAGINA_TAMANHO_PADRAO=20
ATLAS_PAGINA_TAMANHO_MAXIMO=100

# ── A partir do Módulo 07 (integrações) ──────────────────────
# ATLAS_REDIS_URL=redis://localhost:6379/0
# TRANSPORTADORA_API_KEY=
# GATEWAY_PAGAMENTO_TOKEN=
